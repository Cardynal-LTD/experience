      {
        "question": "\u05e6\u05e8\u05d9\u05da \u05de\u05e4\u05ea\u05d7?",
        "answer": "\u05dc\u05d0. \u05d4\u05db\u05dc \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9 \u2014 \u05e7\u05e0\u05d1\u05e1 drag-and-drop \u05dc\u05e1\u05d5\u05db\u05e0\u05d9\u05dd, \u05d1\u05d5\u05e0\u05d4 \u05ea\u05d4\u05dc\u05d9\u05db\u05d9\u05dd, \u05e9\u05d5\u05e7 \u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d5\u05ea. \u05d9\u05e9 \u05d2\u05dd onboarding \u05de\u05dc\u05d5\u05d5\u05d4."
      },
      {
        "question": "\u05d0\u05d9\u05dc\u05d5 \u05e2\u05e8\u05d5\u05e6\u05d9\u05dd \u05db\u05dc\u05d5\u05dc\u05d9\u05dd?",
        "answer": "\u05e6\u05f3\u05d0\u05d8, \u05de\u05d9\u05d9\u05dc (Gmail), \u05d0\u05d9\u05e0\u05e1\u05d8\u05d2\u05e8\u05dd, \u05de\u05e1\u05e0\u05d2\u05f3\u05e8 \u05d5-API \u05db\u05dc\u05d5\u05dc\u05d9\u05dd \u05d1\u05db\u05dc \u05ea\u05d5\u05db\u05e0\u05d9\u05ea. WhatsApp (Meta Cloud API \u05d0\u05d5 QR) \u05db\u05dc\u05d5\u05dc \u05de\u05ea\u05d5\u05db\u05e0\u05d9\u05ea Growth \u05d5\u05de\u05e2\u05dc\u05d4. \u05dc\u05dc\u05d0 \u05ea\u05d5\u05e1\u05e4\u05ea \u05ea\u05e9\u05dc\u05d5\u05dd \u05dc\u05d4\u05d5\u05d3\u05e2\u05d4 \u05e2\u05dc \u05d0\u05e3 \u05e2\u05e8\u05d5\u05e5."
      },
      {
        "question": "\u05d4\u05d0\u05dd \u05e0\u05ea\u05de\u05db\u05d9\u05dd \u05e1\u05d5\u05db\u05e0\u05d9\u05dd \u05e7\u05d5\u05dc\u05d9\u05d9\u05dd / \u05d8\u05dc\u05e4\u05d5\u05e0\u05d9\u05d9\u05dd? (\u05d1\u05e7\u05e8\u05d5\u05d1)",
        "answer": "\u05e1\u05d5\u05db\u05e0\u05d9 AI \u05e7\u05d5\u05dc\u05d9\u05d9\u05dd \u05dc\u05e9\u05d9\u05d7\u05d5\u05ea \u05d8\u05dc\u05e4\u05d5\u05df \u05e0\u05db\u05e0\u05e1\u05d5\u05ea \u05d5\u05d9\u05d5\u05e6\u05d0\u05d5\u05ea \u05d1\u05d3\u05e8\u05da \u05d0\u05dc\u05d9\u05e0\u05d5. \u05d4\u05dd \u05d9\u05e2\u05d1\u05d3\u05d5 \u05db\u05de\u05d5 \u05e1\u05d5\u05db\u05e0\u05d9 \u05d4\u05e6'\u05d0\u05d8 \u05e9\u05dc\u05e0\u05d5 \u2014 \u05d6\u05d9\u05d4\u05d5\u05d9 \u05db\u05d5\u05d5\u05e0\u05d4, \u05d4\u05e8\u05e6\u05ea \u05d4-playbook \u05d4\u05e0\u05db\u05d5\u05df, \u05d4\u05e2\u05d1\u05e8\u05d4 \u05dc\u05d0\u05d3\u05dd \u05e2\u05dd \u05db\u05dc \u05d4\u05d4\u05e7\u05e9\u05e8 \u05db\u05e9\u05e6\u05e8\u05d9\u05da \u2014 \u05e8\u05e7 \u05e9\u05d6\u05d4 \u05d1\u05d8\u05dc\u05e4\u05d5\u05df. \u05e8\u05d5\u05e6\u05d9\u05dd \u05d2\u05d9\u05e9\u05d4 \u05de\u05d5\u05e7\u05d3\u05de\u05ea? \u05d3\u05d1\u05e8\u05d5 \u05d0\u05d9\u05ea\u05e0\u05d5."
      },
      {
        "question": "\u05d0\u05d9\u05da \u05e2\u05d5\u05d1\u05d3 \u05d4\u05ea\u05de\u05d7\u05d5\u05e8?",
        "answer": "\u05de\u05e0\u05d5\u05d9 \u05d7\u05d5\u05d3\u05e9\u05d9 \u05e2\u05dd \u05de\u05db\u05e1\u05d5\u05ea \u05d1\u05e8\u05d5\u05e8\u05d5\u05ea \u2014 \u05e1\u05e9\u05e0\u05d9\u05dd, \u05e1\u05d5\u05db\u05e0\u05d9\u05dd, \u05ea\u05d9\u05d1\u05d5\u05ea \u05d3\u05d5\u05d0\u05e8, \u05de\u05e7\u05d5\u05e8\u05d5\u05ea, \u05ea\u05d4\u05dc\u05d9\u05db\u05d9\u05dd. \u05d1\u05dc\u05d9 \u05e2\u05de\u05dc\u05d4 \u05dc\u05e4\u05ea\u05e8\u05d5\u05df. 14 \u05d9\u05de\u05d9 \u05e0\u05e1\u05d9\u05d5\u05df \u05d7\u05d9\u05e0\u05dd, \u05d1\u05d9\u05d8\u05d5\u05dc \u05d1\u05db\u05dc \u05e8\u05d2\u05e2."
      },
      {
        "question": "\u05d0\u05d9\u05dc\u05d5 \u05ea\u05e8\u05d7\u05d9\u05e9\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 Cardynal \u05de\u05db\u05e1\u05d4?",
        "answer": "\u05ea\u05de\u05d9\u05db\u05ea SaaS, \u05d0\u05d9\u05e7\u05d5\u05de\u05e8\u05e1 (\u05de\u05e2\u05e7\u05d1 \u05d4\u05d6\u05de\u05e0\u05d5\u05ea, \u05d4\u05d7\u05d6\u05e8\u05d5\u05ea), \u05ea\u05d5\u05e8\u05d9 \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea, \u05d1\u05d9\u05d8\u05d5\u05d7, \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd \u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05d9\u05dd \u2014 \u05db\u05dc \u05e2\u05e1\u05e7 \u05e9\u05de\u05e0\u05d4\u05dc \u05e9\u05d9\u05d7\u05d5\u05ea \u05dc\u05e7\u05d5\u05d7\u05d5\u05ea \u05d1\u05e1\u05e7\u05d9\u05d9\u05dc."
      },
      {
        "question": "\u05d0\u05d9\u05dc\u05d5 \u05de\u05d5\u05d3\u05dc\u05d9 AI \u05e0\u05ea\u05de\u05db\u05d9\u05dd?",
        "answer": "OpenAI (GPT-4) \u05d5-Anthropic (Claude). \u05d1\u05d7\u05d9\u05e8\u05d4 \u05dc\u05db\u05dc \u05e1\u05d5\u05db\u05df, \u05d4\u05d7\u05dc\u05e4\u05d4 \u05d1\u05db\u05dc \u05e8\u05d2\u05e2. \u05d4-Embeddings \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d1-OpenAI \u05dc\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d5\u05e7\u05d8\u05d5\u05e8\u05d9 \u05e2\u05e7\u05d1\u05d9."
      }
    ]
  },
